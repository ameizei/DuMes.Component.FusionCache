{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "ZiggyCreatures.Caching.Fusion": "Warning"
    }
  },
  "FusionCache": {
    "Mode": "Standalone",
    "Host": "127.0.0.1",
    "Port": 6389,
    "Password": null,
    "DefaultDatabase": 0,
    "KeyPrefix": "DuMes:worker:standalone:",
    "PoolSize": 20,
    "EnableDistributedCache": true,
    "EnableBackplane": true,
    "DefaultL1DurationSeconds": 60,
    "DefaultL2DurationSeconds": 300,
    "IsFailSafeEnabled": true,
    "FailSafeMaxDurationSeconds": 3600
  }
}
